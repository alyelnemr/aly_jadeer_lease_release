<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_aly_unit_state" model="ir.cron">
        <field name="name">Real Estate: refresh unit status</field>
        <field name="model_id" ref="model_aly_entity_unit"/>
        <field name="state">code</field>
        <field name="code">model._cron_recompute_state()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 00:05:00')"/>
    </record>

    <record id="ir_cron_aly_reservation_expiry" model="ir.cron">
        <field name="name">Real Estate: expire reservations and remind</field>
        <field name="model_id" ref="model_aly_entity_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_reservations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 00:10:00')"/>
    </record>

    <record id="ir_cron_aly_invoice_reminder" model="ir.cron">
        <field name="name">Real Estate: remind invoices to send</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_aly_invoice_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 00:15:00')"/>
    </record>

</odoo>
