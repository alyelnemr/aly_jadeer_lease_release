#. module: aly_entity_management
#: model:mail.template,body_html:aly_entity_management.mail_template_contract_signature
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Dear <t t-out=\"object.partner_id.name or ''\">Customer</t>,</p>\n"
"    <p>\n"
"        Your contract <strong t-out=\"object.name or ''\">CON/2027/0001</strong> for unit\n"
"        <strong t-out=\"object.unit_id.display_name or ''\">A-101</strong> is ready.\n"
"        Its full value is <strong t-out=\"format_amount(object.total_amount, object.currency_id) or ''\">62,500.00</strong>.\n"
"    </p>\n"
"    <p>Please review and sign it online before\n"
"        <strong t-out=\"format_date(object.reservation_id.expiry_date) or ''\">01/01/2027</strong>:</p>\n"
"    <p style=\"margin: 16px 0px;\">\n"
"        <a t-att-href=\"object.get_base_url() + object.get_portal_url()\" style=\"background-color: #875A7B; padding: 8px 16px; color: #fff; border-radius: 5px; text-decoration: none;\">\n"
"            Review and Sign\n"
"        </a>\n"
"    </p>\n"
"    <p>Best regards,<br/><t t-out=\"object.company_id.name or ''\">Company</t></p>\n"
"</div>\n"
"        "
msgstr ""

#. module: aly_entity_management
#: model:mail.template,body_html:aly_entity_management.mail_template_reservation_confirmed
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Dear <t t-out=\"object.partner_id.name or ''\">Customer</t>,</p>\n"
"    <p>\n"
"        Your reservation <strong t-out=\"object.name or ''\">RES/2027/0001</strong> of unit\n"
"        <strong t-out=\"object.unit_id.display_name or ''\">A-101</strong> is confirmed.\n"
"    </p>\n"
"    <p>\n"
"        It is valid until <strong t-out=\"format_date(object.expiry_date) or ''\">01/01/2027</strong>.\n"
"        We will send you the contract to sign shortly.\n"
"    </p>\n"
"    <p>Best regards,<br/><t t-out=\"object.company_id.name or ''\">Company</t></p>\n"
"</div>\n"
"        "
msgstr ""

