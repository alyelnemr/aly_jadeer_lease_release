<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit_aly_entity" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.aly.entity</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='coach_id']" position="after">
                <field name="is_maintenance_worker"/>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_list_aly_worker" model="ir.ui.view">
        <field name="name">hr.employee.view.list.aly.worker</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Maintenance Workers" editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="job_title" readonly="1"/>
                <field name="department_id" readonly="1"/>
                <field name="work_phone" readonly="1"/>
                <field name="is_maintenance_worker" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="hr_employee_action_aly_worker" model="ir.actions.act_window">
        <field name="name">Maintenance Workers</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_filter_aly_worker': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hr_employee_view_list_aly_worker')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No maintenance workers yet</p>
            <p>Remove the filter and switch on "Maintenance Worker" for the employees who do
                maintenance work, so their hours can be recorded on contracts.</p>
        </field>
    </record>

    <record id="hr_employee_view_search_inherit_aly_entity" model="ir.ui.view">
        <field name="name">hr.employee.view.search.inherit.aly.entity</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter name="filter_aly_worker" string="Maintenance Workers" domain="[('is_maintenance_worker', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
